#!/usr/bin/env bash
# predio - painel de controle do Prédio Hermes FAD
# Uso: ./predio <comando> [andar]        (./predio ajuda)
set -euo pipefail

RAIZ="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PREDIO_DADOS="${PREDIO_DADOS:-/opt/predio-dados}"   # tudo que muda e é privado
ANDARES=(porteiro skip marketing)                          # ordem de subida: o porteiro primeiro
UID_HERMES=10000                                           # dono da pasta de dados dentro da imagem do Hermes
REDE_INTERNA=predio_interna                                # sem saída para a internet
REDE_EXTERNA=predio_externa                                # com saída para a internet
PASTAS_CORREIO=(trabalhos pedidos pesquisas rascunhos prontos decisoes aprovados enviados rejeitados metricas avisos)
ALVOS=()

erro() { echo "ERRO: $*" >&2; exit 1; }

validar_andar() {
  local a
  for a in "${ANDARES[@]}"; do [[ "$a" == "$1" ]] && return 0; done
  erro "andar desconhecido: '$1'. Andares: ${ANDARES[*]}"
}

definir_alvos() {  # sem argumento ou "tudo": todos os andares; senão, só o pedido
  local alvo="${1:-tudo}"
  if [[ "$alvo" == "tudo" ]]; then ALVOS=("${ANDARES[@]}"); else validar_andar "$alvo"; ALVOS=("$alvo"); fi
}

compose() {  # compose <andar> <argumentos do docker compose>
  local andar="$1"; shift
  docker compose -p "predio-$andar" -f "$RAIZ/andares/$andar/compose.yml" "$@"
}

cmd_instalar() {
  [[ "$EUID" -eq 0 ]] || erro "rode como root (por causa do dono das pastas de dados)"
  command -v docker >/dev/null || erro "docker não encontrado"
  docker compose version >/dev/null 2>&1 || erro "docker compose não encontrado"
  git -C "$RAIZ" config core.fileMode false 2>/dev/null || true
  chmod +x "$RAIZ/predio"
  if ! docker network inspect "$REDE_INTERNA" >/dev/null 2>&1; then
    docker network create --internal "$REDE_INTERNA" >/dev/null
    echo "rede criada: $REDE_INTERNA (interna, sem internet)"
  fi
  if ! docker network inspect "$REDE_EXTERNA" >/dev/null 2>&1; then
    docker network create "$REDE_EXTERNA" >/dev/null
    echo "rede criada: $REDE_EXTERNA (com internet)"
  fi
  mkdir -p "$PREDIO_DADOS/skip" "$PREDIO_DADOS/marketing" "$PREDIO_DADOS/marca" "$PREDIO_DADOS/segredos"
  local p
  for p in "${PASTAS_CORREIO[@]}"; do mkdir -p "$PREDIO_DADOS/correio/$p"; done
  chmod 700 "$PREDIO_DADOS/segredos" "$PREDIO_DADOS/skip" "$PREDIO_DADOS/marketing"
  # Os Hermes rodam como o usuário $UID_HERMES dentro do contêiner: ele precisa ser dono do que escreve.
  chown "$UID_HERMES:$UID_HERMES" "$PREDIO_DADOS/skip" "$PREDIO_DADOS/marketing"
  chown -R "$UID_HERMES:$UID_HERMES" "$PREDIO_DADOS/correio" "$PREDIO_DADOS/marca"
  echo "pastas de dados prontas em $PREDIO_DADOS"
  echo "próximo passo: docs/MIGRACAO.md (trazer a memória dos Hermes atuais)"
}

cmd_status() {
  docker ps -a --filter label=predio.andar \
    --format 'table {{.Label "predio.andar"}}\t{{.Names}}\t{{.Status}}\t{{.Label "predio.internet"}}'
}

cmd_conversar() {
  local andar="${1:-}"; [[ -n "$andar" ]] || erro "use: ./predio conversar <andar>"
  validar_andar "$andar"
  local tipo
  tipo="$(docker inspect -f '{{index .Config.Labels "predio.tipo"}}' "predio-$andar" 2>/dev/null || true)"
  [[ "$tipo" == "hermes" ]] || erro "o andar '$andar' não é um Hermes ou não está no ar"
  docker exec -it "predio-$andar" hermes chat
}

cmd_auditar() {
  local ids c n alertas=0 modelo andar internet
  ids="$(docker ps -aq --filter label=predio.andar)"
  [[ -n "$ids" ]] || erro "nenhum contêiner do prédio encontrado"
  modelo='=== {{.Name}}  (andar: {{index .Config.Labels "predio.andar"}})
imagem:       {{.Config.Image}}
usuário:      {{if .Config.User}}{{.Config.User}}{{else}}(padrão da imagem){{end}}
reinício:     {{.HostConfig.RestartPolicy.Name}}
privilegiado: {{.HostConfig.Privileged}}
redes:        {{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}
montagens:
{{range .Mounts}}  {{.Source}} -> {{.Destination}} ({{if .RW}}escrita{{else}}só leitura{{end}})
{{end}}variáveis (só os nomes):
{{range .Config.Env}}  {{println (index (split . "=") 0)}}{{end}}'
  for c in $ids; do
    docker inspect "$c" --format "$modelo"
    andar="$(docker inspect -f '{{index .Config.Labels "predio.andar"}}' "$c")"
    if [[ "$(docker inspect -f '{{.HostConfig.Privileged}}' "$c")" == "true" ]]; then
      echo "  ALERTA: contêiner privilegiado"; alertas=$((alertas+1))
    fi
    if [[ -n "$(docker inspect -f '{{range $p, $b := .NetworkSettings.Ports}}{{if $b}}x{{end}}{{end}}' "$c")" ]]; then
      echo "  ALERTA: porta publicada no servidor"; alertas=$((alertas+1))
    fi
    internet="$(docker inspect -f '{{index .Config.Labels "predio.internet"}}' "$c")"
    if [[ "$internet" == nao* ]]; then
      for n in $(docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' "$c"); do
        if [[ "$(docker network inspect -f '{{.Internal}}' "$n")" != "true" ]]; then
          echo "  ALERTA: rótulo diz 'sem internet', mas a rede '$n' não é interna"; alertas=$((alertas+1))
        fi
      done
    fi
    if [[ "$(docker inspect -f '{{index .Config.Labels "predio.tipo"}}' "$c")" == "hermes" ]]; then
      if [[ -n "$(docker inspect -f '{{range .Mounts}}{{if and (eq .Destination "/opt/data/skills/'"$andar"'") .RW}}x{{end}}{{end}}' "$c")" ]]; then
        echo "  ALERTA: as skills do andar estão com escrita (deveriam ser só leitura)"; alertas=$((alertas+1))
      fi
    fi
    echo
  done
  echo "=== redes do prédio"
  docker network ls --filter name=predio_ --format '{{.Name}}' | while read -r n; do
    echo "  $n  interna=$(docker network inspect -f '{{.Internal}}' "$n")"
  done
  echo
  if [[ "$alertas" -eq 0 ]]; then echo "Auditoria: nenhum alerta."; else echo "Auditoria: $alertas alerta(s)."; exit 1; fi
}

cmd_ajuda() {
  cat <<'TXT'
predio - painel de controle do Prédio Hermes FAD

  ./predio instalar              cria as redes e as pastas de dados (uma vez)
  ./predio atualizar             baixa do GitHub as skills, SOULs e composes novos
  ./predio subir [andar|tudo]    liga (e constrói, se preciso)
  ./predio parar [andar|tudo]    desliga (os dados ficam)
  ./predio reconstruir [andar]   recria o contêiner (depois de atualizar)
  ./predio status                lista os andares e se estão no ar
  ./predio logs <andar>          acompanha o que o andar está fazendo
  ./predio conversar <andar>     abre o chat do Hermes do andar
  ./predio auditar               mostra montagens, redes, usuário e confere as regras

Andares: porteiro, skip, marketing
TXT
}

cmd="${1:-ajuda}"; shift || true
case "$cmd" in
  instalar)    cmd_instalar ;;
  atualizar)   git -C "$RAIZ" pull --ff-only; echo "Agora rode: ./predio reconstruir <andar>" ;;
  subir)       definir_alvos "${1:-}"; for a in "${ALVOS[@]}"; do echo ">> subindo $a"; compose "$a" up -d --build; done ;;
  parar)       definir_alvos "${1:-}"; for ((i=${#ALVOS[@]}-1; i>=0; i--)); do echo ">> parando ${ALVOS[$i]}"; compose "${ALVOS[$i]}" stop; done ;;
  reconstruir) definir_alvos "${1:-}"; for a in "${ALVOS[@]}"; do echo ">> reconstruindo $a"; compose "$a" up -d --build --force-recreate; done ;;
  status)      cmd_status ;;
  logs)        [[ -n "${1:-}" ]] || erro "use: ./predio logs <andar>"; validar_andar "$1"; compose "$1" logs -f --tail 100 ;;
  conversar)   cmd_conversar "${1:-}" ;;
  auditar)     cmd_auditar ;;
  ajuda|-h|--help) cmd_ajuda ;;
  *)           erro "comando desconhecido: $cmd (veja ./predio ajuda)" ;;
esac
